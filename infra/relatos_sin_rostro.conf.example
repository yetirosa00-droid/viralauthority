# RELATOS SIN ROSTRO - Nginx Config Template
# Use this to keep the sites separate on the same VPS (167.86.74.3)

server {
    listen 80;
    server_name relatossinrostro.com www.relatossinrostro.com;
    server_tokens off;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    location / {
        # CHANGE THIS to the actual port where Relatos Sin Rostro is running
        # Example: if it's another Next.js app on port 4000
        proxy_pass http://localhost:4000; 
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
